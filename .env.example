# =============================================================================
# Cadence Environment Configuration
# Copy this file to .env at the repository root to customize variables.
# =============================================================================

# PostgreSQL Container Credentials (used by postgres service in docker-compose)
POSTGRES_DB=cadence
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence_dev_secret

# Database Connection URL
#
# Containerized stack (Docker Compose service-to-service networking):
DATABASE_URL=postgresql://cadence:cadence_dev_secret@postgres:5432/cadence
#
# Host machine connecting to containerized PostgreSQL:
# DATABASE_URL=postgresql://cadence:cadence_dev_secret@localhost:5432/cadence
#
# Local development with standalone SQLite (default if DATABASE_URL is unset):
# DATABASE_URL=sqlite:///./cadence.db

# Frontend Build & Routing Configuration
#
# Containerized stack (relative path proxied by Nginx to backend):
VITE_API_BASE_URL=/api
#
# Local development Vite dev server pointing to standalone uvicorn:
# VITE_API_BASE_URL=http://localhost:8000
